<Window x:Class="ParaPhraser.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParaPhraser"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="{StaticResource OverlayAccentBorderBrush}"
            CornerRadius="19">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34"
                              Direction="270"
                              Opacity="0.48"
                              ShadowDepth="10"
                              Color="#FF080A10" />
        </Border.Effect>

        <Border Margin="1"
                Padding="23"
                Background="{StaticResource OverlayBackgroundBrush}"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            Background="{StaticResource OverlayAccentGradientBrush}"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              Direction="270"
                                              Opacity="0.3"
                                              ShadowDepth="3"
                                              Color="#FF7655C8" />
                        </Border.Effect>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="P"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,1,16,0">
                        <TextBlock Text="ParaPhraser"
                                   Foreground="{StaticResource OverlayTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource OverlayMutedTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="0,5,10,5"
                            Padding="10,5"
                            Background="#2EA78BFA"
                            BorderBrush="#507C64C8"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource OverlayAccentBrush}" />
                            <TextBlock x:Name="ModeText"
                                       Foreground="#FFC4B5FD"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="SettingsButton"
                            Grid.Column="3"
                            Width="32"
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="0"
                            AutomationProperties.Name="Settings"
                            Content="&#xE713;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            FontWeight="Normal"
                            ToolTip="Settings: change the provider or model"
                            Click="SettingsButton_Click"
                            Style="{StaticResource OverlayButtonStyle}" />

                    <Button Grid.Column="4"
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Close"
                            Content="×"
                            ToolTip="Close"
                            Click="CloseButton_Click"
                            Style="{StaticResource OverlayButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,21,0,0">
                    <Grid Margin="1,0,1,8">
                        <TextBlock Text="SELECTED TEXT"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Border HorizontalAlignment="Right"
                                Padding="8,3"
                                Background="#2463D7B0"
                                CornerRadius="9">
                            <TextBlock Text="EDITABLE"
                                       Foreground="{StaticResource OverlaySuccessBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Padding="16,12"
                            Background="{StaticResource OverlayPaperBrush}"
                            CornerRadius="11">
                        <RichTextBox x:Name="OriginalText"
                                     AutomationProperties.Name="Selected text"
                                     MinHeight="46"
                                     MaxHeight="112"
                                     Style="{StaticResource PaperEditorStyle}" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="16,12,16,16"
                        Style="{StaticResource ComposerBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           Text="✦"
                                           Foreground="{StaticResource OverlayAccentBrush}"
                                           FontSize="13" />
                                <TextBlock Text="Ask ParaPhraser"
                                           Foreground="{StaticResource OverlayTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="Ctrl + Enter to generate"
                                       Foreground="{StaticResource OverlayMutedTextBrush}"
                                       FontSize="11" />
                        </Grid>

                        <Grid>
                            <TextBox x:Name="InstructionText"
                                     AutomationProperties.Name="Instruction"
                                     MinHeight="48"
                                     MaxHeight="100"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource OverlayTextBrush}"
                                     CaretBrush="{StaticResource OverlayAccentBrush}"
                                     SelectionBrush="#807C64C8"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Margin="2,0,0,0"
                                       IsHitTestVisible="False"
                                       Text="Tell ParaPhraser what to change…"
                                       Foreground="{StaticResource OverlayMutedTextBrush}"
                                       FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InstructionText}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Margin="1,0,0,8"
                                           Text="ACTION"
                                           Style="{StaticResource SectionLabelStyle}" />
                                <ComboBox x:Name="ActionComboBox"
                                          AutomationProperties.Name="Action"
                                          Height="40"
                                          SelectionChanged="ActionComboBox_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="Fix grammar" />
                                    <ComboBoxItem Content="Rewrite" />
                                    <ComboBoxItem Content="Shorten" />
                                    <ComboBoxItem Content="Format" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="1,0,0,8"
                                           Text="TONE"
                                           Style="{StaticResource SectionLabelStyle}" />
                                <ComboBox x:Name="ToneComboBox"
                                          AutomationProperties.Name="Tone"
                                          Height="40"
                                          SelectedIndex="0"
                                          Style="{StaticResource ModernComboBoxStyle}">
                                    <ComboBoxItem Content="Original" />
                                    <ComboBoxItem Content="Polite" />
                                    <ComboBoxItem Content="Professional" />
                                    <ComboBoxItem Content="Casual" />
                                    <ComboBoxItem Content="Emojified" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="1,0,0,8"
                                           Text="SAVED"
                                           Style="{StaticResource SectionLabelStyle}" />
                                <ComboBox x:Name="SavedComboBox"
                                          AutomationProperties.Name="Saved instructions"
                                          Height="40"
                                          ToolTip="Use a saved instruction. Manage them in Settings."
                                          SelectionChanged="SavedComboBox_SelectionChanged"
                                          Style="{StaticResource ModernComboBoxStyle}" />
                            </StackPanel>

                            <Button x:Name="GenerateButton"
                                    Grid.Column="6"
                                    MinWidth="112"
                                    Height="40"
                                    VerticalAlignment="Bottom"
                                    Content="Generate  ✦"
                                    Click="GenerateButton_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="1,12,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 Fill="{StaticResource OverlaySuccessBrush}" />
                        <TextBlock x:Name="PrivacyText"
                                   Text="Private processing · No history stored"
                                   Foreground="{StaticResource OverlayMutedTextBrush}"
                                   FontSize="10" />
                    </StackPanel>

                    <Border x:Name="EnglishOutputBadge"
                            Grid.Column="2"
                            Padding="11,6"
                            Background="{StaticResource OverlayRaisedSurfaceBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource OverlayAccentBrush}" />
                            <TextBlock Text="English output · always"
                                       Foreground="{StaticResource OverlayTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="ResultPanel"
                            Grid.Row="4"
                            Margin="0,16,0,0"
                            Visibility="Collapsed">
                    <Grid Margin="1,0,1,8">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Text="SUGGESTION"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <Button x:Name="ChangesButton"
                                    Margin="12,0,0,0"
                                    Padding="12,0"
                                    Height="32"
                                    Content="Show changes"
                                    ToolTip="Compare the suggestion with your original text"
                                    Visibility="Collapsed"
                                    Click="ChangesButton_Click"
                                    Style="{StaticResource OverlayButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="FormatToolbar"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button AutomationProperties.Name="Bold"
                                    Content="B"
                                    FontWeight="Bold"
                                    ToolTip="Bold (Ctrl+B)"
                                    Command="EditingCommands.ToggleBold"
                                    CommandTarget="{Binding ElementName=ResultText}"
                                    Style="{StaticResource FormatButtonStyle}" />
                            <Button AutomationProperties.Name="Italic"
                                    Content="I"
                                    FontStyle="Italic"
                                    ToolTip="Italic (Ctrl+I)"
                                    Command="EditingCommands.ToggleItalic"
                                    CommandTarget="{Binding ElementName=ResultText}"
                                    Style="{StaticResource FormatButtonStyle}" />
                            <Button AutomationProperties.Name="Underline"
                                    ToolTip="Underline (Ctrl+U)"
                                    Command="EditingCommands.ToggleUnderline"
                                    CommandTarget="{Binding ElementName=ResultText}"
                                    Style="{StaticResource FormatButtonStyle}">
                                <TextBlock Text="U" TextDecorations="Underline" />
                            </Button>
                            <Button AutomationProperties.Name="Bulleted list"
                                    Content="•"
                                    ToolTip="Bulleted list"
                                    Command="EditingCommands.ToggleBullets"
                                    CommandTarget="{Binding ElementName=ResultText}"
                                    Style="{StaticResource FormatButtonStyle}" />
                            <Button x:Name="ColorButton"
                                    AutomationProperties.Name="Text color and highlight"
                                    Focusable="True"
                                    ToolTip="Text color and highlight"
                                    Click="ColorButton_Click"
                                    Style="{StaticResource FormatButtonStyle}">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center" Text="A" />
                                    <Border Width="14"
                                            Height="3"
                                            Background="{StaticResource OverlayAccentGradientBrush}"
                                            CornerRadius="1" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ColorPopup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=ColorButton}"
                                   PreviewKeyDown="ColorPopup_PreviewKeyDown"
                                   StaysOpen="False">
                                <Border Margin="0,4,0,0"
                                        Padding="12"
                                        Background="{StaticResource OverlayPaperBrush}"
                                        BorderBrush="{StaticResource OverlayStrongBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,4"
                                                   Text="Text color"
                                                   Foreground="{StaticResource OverlayPaperTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <StackPanel x:Name="TextColorSwatches" Orientation="Horizontal" />
                                        <TextBlock Margin="0,8,0,4"
                                                   Text="Highlight"
                                                   Foreground="{StaticResource OverlayPaperTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <StackPanel x:Name="HighlightSwatches" Orientation="Horizontal" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <Border MinHeight="92"
                            MaxHeight="215"
                            Background="{StaticResource OverlayPaperBrush}"
                            CornerRadius="11">
                        <Grid>
                            <Border Width="3"
                                    Margin="0,12,0,12"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource OverlayAccentGradientBrush}"
                                    CornerRadius="0,2,2,0" />
                            <RichTextBox x:Name="ResultText"
                                         AutomationProperties.Name="Suggestion"
                                         Margin="16,12,12,12"
                                         IsReadOnly="True"
                                         Style="{StaticResource PaperEditorStyle}" />
                        </Grid>
                    </Border>

                    <Button x:Name="FallbackButton"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="FallbackButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="5" Margin="1,16,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource OverlayMutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            MinWidth="76"
                            Content="Copy"
                            Click="CopyButton_Click"
                            Style="{StaticResource OverlayButtonStyle}" />

                    <Button x:Name="ReplaceButton"
                            Grid.Column="2"
                            MinWidth="90"
                            Margin="9,0,0,0"
                            Content="Replace"
                            Click="ReplaceButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
