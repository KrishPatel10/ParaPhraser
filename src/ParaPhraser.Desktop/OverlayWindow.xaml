<Window x:Class="ParaPhraser.Desktop.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParaPhraser"
        Width="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="14"
            Background="{StaticResource OverlayAccentBorderBrush}"
            CornerRadius="19">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34"
                              Direction="270"
                              Opacity="0.48"
                              ShadowDepth="10"
                              Color="#FF080A10" />
        </Border.Effect>

        <Border Margin="1"
                Padding="23"
                Background="{StaticResource OverlayBackgroundBrush}"
                CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="42"
                            Height="42"
                            Background="{StaticResource OverlayAccentGradientBrush}"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12"
                                              Direction="270"
                                              Opacity="0.3"
                                              ShadowDepth="3"
                                              Color="#FF7655C8" />
                        </Border.Effect>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="P"
                                   Foreground="White"
                                   FontSize="19"
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="13,1,16,0">
                        <TextBlock Text="ParaPhraser"
                                   Foreground="{StaticResource OverlayTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource OverlayMutedTextBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Margin="0,5,10,5"
                            Padding="10,5"
                            Background="#2EA78BFA"
                            BorderBrush="#507C64C8"
                            BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource OverlayAccentBrush}" />
                            <TextBlock x:Name="ModeText"
                                       Foreground="#FFC4B5FD"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="3"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Content="×"
                            ToolTip="Close"
                            Click="CloseButton_Click"
                            Style="{StaticResource OverlayButtonStyle}" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,21,0,0">
                    <Grid Margin="1,0,1,8">
                        <TextBlock Text="SELECTED CONTEXT"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <Border HorizontalAlignment="Right"
                                Padding="8,3"
                                Background="#2463D7B0"
                                CornerRadius="9">
                            <TextBlock Text="EDITABLE"
                                       Foreground="{StaticResource OverlaySuccessBrush}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <Border Padding="13,11"
                            Background="{StaticResource OverlaySurfaceBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBox x:Name="OriginalText"
                                 MinHeight="46"
                                 MaxHeight="112"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource OverlayTextBrush}"
                                 CaretBrush="{StaticResource OverlayAccentBrush}"
                                 SelectionBrush="#807C64C8"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,17,0,0">
                    <Grid Margin="1,0,1,8">
                        <TextBlock Text="YOUR INSTRUCTION"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Text="CTRL + ENTER TO GENERATE"
                                   Foreground="{StaticResource OverlayMutedTextBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Border Padding="13,10"
                            Background="{StaticResource OverlaySurfaceBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <TextBox x:Name="InstructionText"
                                 MinHeight="48"
                                 MaxHeight="100"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource OverlayTextBrush}"
                                 CaretBrush="{StaticResource OverlayAccentBrush}"
                                 SelectionBrush="#807C64C8"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Margin="1,0,0,7"
                                   Text="ACTION"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox x:Name="ActionComboBox"
                                  Height="40"
                                  SelectionChanged="ActionComboBox_SelectionChanged"
                                  Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="Fix grammar" />
                            <ComboBoxItem Content="Rewrite" />
                            <ComboBoxItem Content="Shorten" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="1,0,0,7"
                                   Text="TONE"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <ComboBox x:Name="ToneComboBox"
                                  Height="40"
                                  SelectedIndex="0"
                                  Style="{StaticResource ModernComboBoxStyle}">
                            <ComboBoxItem Content="Original" />
                            <ComboBoxItem Content="Polite" />
                            <ComboBoxItem Content="Professional" />
                            <ComboBoxItem Content="Casual" />
                            <ComboBoxItem Content="Emojified" />
                        </ComboBox>
                    </StackPanel>

                    <Button x:Name="GenerateButton"
                            Grid.Column="4"
                            MinWidth="112"
                            Height="40"
                            Margin="0,22,0,0"
                            Content="Generate  ✦"
                            Click="GenerateButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="4" Margin="1,13,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,7,0"
                                 Fill="{StaticResource OverlaySuccessBrush}" />
                        <TextBlock Text="Private processing · No history stored"
                                   Foreground="{StaticResource OverlayMutedTextBrush}"
                                   FontSize="10" />
                    </StackPanel>

                    <Border Grid.Column="2"
                            Padding="11,6"
                            Background="{StaticResource OverlayRaisedSurfaceBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,7,0"
                                     Fill="{StaticResource OverlayAccentBrush}" />
                            <TextBlock Text="English output · always"
                                       Foreground="{StaticResource OverlayTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel x:Name="ResultPanel"
                            Grid.Row="5"
                            Margin="0,19,0,0"
                            Visibility="Collapsed">
                    <Grid Margin="1,0,1,8">
                        <TextBlock Text="SUGGESTION"
                                   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Text="LOCAL AI RESULT"
                                   Foreground="{StaticResource OverlayAccentBrush}"
                                   FontSize="9"
                                   FontWeight="SemiBold" />
                    </Grid>

                    <Border MinHeight="92"
                            MaxHeight="215"
                            Background="{StaticResource OverlaySurfaceBrush}"
                            BorderBrush="{StaticResource OverlayBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="11">
                        <Grid>
                            <Border Width="3"
                                    Margin="0,12,0,12"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource OverlayAccentGradientBrush}"
                                    CornerRadius="0,2,2,0" />
                            <TextBox x:Name="ResultText"
                                     Margin="16,12,13,12"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource OverlayTextBrush}"
                                     SelectionBrush="#807C64C8"
                                     FontSize="13"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="6" Margin="1,16,1,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Margin="0,0,12,0"
                               Foreground="{StaticResource OverlayMutedTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />

                    <Button x:Name="CopyButton"
                            Grid.Column="1"
                            MinWidth="76"
                            Content="Copy"
                            Click="CopyButton_Click"
                            Style="{StaticResource OverlayButtonStyle}" />

                    <Button x:Name="ReplaceButton"
                            Grid.Column="2"
                            MinWidth="90"
                            Margin="9,0,0,0"
                            Content="Replace"
                            Click="ReplaceButton_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
