<Window x:Class="ParaPhraser.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParaPhraser settings"
        Width="588"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border Margin="14"
            Background="{StaticResource OverlayAccentBorderBrush}"
            CornerRadius="19">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34"
                              Direction="270"
                              Opacity="0.48"
                              ShadowDepth="10"
                              Color="#FF080A10" />
        </Border.Effect>

    <Border Margin="1"
            Background="{StaticResource OverlayBackgroundBrush}"
            CornerRadius="18">
    <StackPanel Margin="24">
        <Grid Background="Transparent"
              Cursor="SizeAll"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="Choose how ParaPhraser writes"
                       Foreground="{StaticResource OverlayTextBrush}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <Button Grid.Column="1"
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Close"
                    Content="×"
                    ToolTip="Close"
                    Click="CancelButton_Click"
                    Style="{StaticResource OverlayButtonStyle}" />
        </Grid>

        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <RadioButton x:Name="AiTabButton"
                         GroupName="Tabs"
                         Content="AI model"
                         IsChecked="True"
                         Checked="Tab_Checked"
                         Style="{StaticResource SettingsTabStyle}" />
            <RadioButton x:Name="ShortcutsTabButton"
                         GroupName="Tabs"
                         Content="Shortcuts"
                         Checked="Tab_Checked"
                         Style="{StaticResource SettingsTabStyle}" />
            <RadioButton x:Name="InstructionsTabButton"
                         GroupName="Tabs"
                         Content="Saved instructions"
                         Checked="Tab_Checked"
                         Style="{StaticResource SettingsTabStyle}" />
        </StackPanel>

        <StackPanel x:Name="ShortcutsTab" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="Click a box, then press the keys you want."
                       Foreground="{StaticResource OverlayTextBrush}"
                       FontSize="13" />
            <TextBlock Margin="0,4,0,0"
                       Text="Some keyboards use Ctrl+Alt to type special characters. If a shortcut gets in your way, try Ctrl+Shift or Win with a key."
                       Foreground="{StaticResource OverlayMutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="Fix grammar"
                           Foreground="{StaticResource OverlayTextBrush}"
                           FontSize="13" />
                <TextBox x:Name="GrammarShortcutBox"
                         Grid.Column="1"
                         AutomationProperties.Name="Fix grammar shortcut"
                         IsReadOnly="True"
                         PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                         GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                         LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                         Style="{StaticResource SettingsTextBoxStyle}" />

                <TextBlock Grid.Row="2"
                           VerticalAlignment="Center"
                           Text="Rewrite"
                           Foreground="{StaticResource OverlayTextBrush}"
                           FontSize="13" />
                <TextBox x:Name="RewriteShortcutBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         AutomationProperties.Name="Rewrite shortcut"
                         IsReadOnly="True"
                         PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                         GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                         LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                         Style="{StaticResource SettingsTextBoxStyle}" />

                <TextBlock Grid.Row="4"
                           VerticalAlignment="Center"
                           Text="Format"
                           Foreground="{StaticResource OverlayTextBrush}"
                           FontSize="13" />
                <TextBox x:Name="FormatShortcutBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         AutomationProperties.Name="Format shortcut"
                         IsReadOnly="True"
                         PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                         GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                         LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                         Style="{StaticResource SettingsTextBoxStyle}" />

                <TextBlock Grid.Row="6"
                           VerticalAlignment="Center"
                           Text="Direct replace"
                           Foreground="{StaticResource OverlayTextBrush}"
                           FontSize="13" />
                <TextBox x:Name="InstantShortcutBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         AutomationProperties.Name="Direct replace shortcut"
                         IsReadOnly="True"
                         PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                         GotKeyboardFocus="ShortcutBox_GotKeyboardFocus"
                         LostKeyboardFocus="ShortcutBox_LostKeyboardFocus"
                         Style="{StaticResource SettingsTextBoxStyle}" />
            </Grid>

            <TextBlock Margin="1,16,0,8"
                       Text="DIRECT REPLACE DOES"
                       Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="InstantModeComboBox"
                      AutomationProperties.Name="Direct replace action"
                      Height="40"
                      Style="{StaticResource ModernComboBoxStyle}">
                <ComboBoxItem Content="Fix grammar" />
                <ComboBoxItem Content="Rewrite" />
                <ComboBoxItem Content="Shorten" />
            </ComboBox>
            <TextBlock Margin="1,8,0,0"
                       Text="Pastes straight away with an Undo button. If a detail looks missing, it opens the suggestion for you to check instead."
                       Foreground="{StaticResource OverlayMutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="InstructionsTab" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="These appear in the Saved list next to Action and Tone."
                       Foreground="{StaticResource OverlayTextBrush}"
                       FontSize="13" />
            <ScrollViewer Margin="0,12,0,0"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SavedInstructionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox AutomationProperties.Name="Instruction name"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                <TextBox Grid.Column="2"
                                         AutomationProperties.Name="Instruction text"
                                         AcceptsReturn="True"
                                         MaxHeight="90"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         Text="{Binding Instruction, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SettingsTextBoxStyle}" />
                                <Button Grid.Column="4"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Remove instruction"
                                        Content="×"
                                        ToolTip="Remove"
                                        Click="RemoveInstructionButton_Click"
                                        Style="{StaticResource OverlayButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Content="Add instruction"
                    Click="AddInstructionButton_Click"
                    Style="{StaticResource OverlayButtonStyle}" />
        </StackPanel>

        <StackPanel x:Name="AiTab">
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <RadioButton x:Name="OfflineMode"
                         GroupName="Mode"
                         AutomationProperties.Name="Offline mode"
                         Checked="Mode_Checked"
                         Style="{StaticResource ModeCardStyle}">
                <StackPanel>
                    <TextBlock Text="Offline"
                               Foreground="{StaticResource OverlayTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Runs on this PC with Ollama. Your text never leaves your computer."
                               Foreground="{StaticResource OverlayMutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="OnlineMode"
                         Grid.Column="2"
                         GroupName="Mode"
                         AutomationProperties.Name="Online mode"
                         Checked="Mode_Checked"
                         Style="{StaticResource ModeCardStyle}">
                <StackPanel>
                    <TextBlock Text="Online"
                               Foreground="{StaticResource OverlayTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Uses your own API key. Selected text goes to the provider you choose."
                               Foreground="{StaticResource OverlayMutedTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <StackPanel x:Name="OfflinePanel" Margin="0,16,0,0">
            <TextBlock x:Name="OllamaStatusText"
                       Foreground="{StaticResource OverlayTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap" />

            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button Content="Get Ollama"
                        Click="GetOllamaButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
                <Button Margin="8,0,0,0"
                        Content="Check again"
                        Click="CheckOllamaButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </StackPanel>

            <TextBlock Margin="1,16,0,8"
                       Text="MODEL"
                       Style="{StaticResource SectionLabelStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="OfflineModelComboBox"
                          AutomationProperties.Name="Offline model"
                          Height="40"
                          IsEditable="True"
                          Style="{StaticResource ModernComboBoxStyle}" />
                <Button x:Name="DownloadModelButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Download model"
                        Click="DownloadModelButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </Grid>
        </StackPanel>

        <StackPanel x:Name="OnlinePanel" Margin="0,16,0,0">
            <TextBlock Margin="1,0,0,8"
                       Text="PROVIDER"
                       Style="{StaticResource SectionLabelStyle}" />
            <ComboBox x:Name="ProviderComboBox"
                      AutomationProperties.Name="Provider"
                      Height="40"
                      DisplayMemberPath="Name"
                      SelectionChanged="ProviderComboBox_SelectionChanged"
                      Style="{StaticResource ModernComboBoxStyle}" />

            <TextBlock Margin="1,16,0,8"
                       Text="API KEY"
                       Style="{StaticResource SectionLabelStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyBox"
                             AutomationProperties.Name="API key"
                             Height="40"
                             Style="{StaticResource SettingsPasswordBoxStyle}" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Get a key"
                        Click="GetKeyButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
                <Button x:Name="RemoveKeyButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="Remove"
                        Click="RemoveKeyButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </Grid>
            <TextBlock x:Name="KeyHintText"
                       Margin="1,8,0,0"
                       Foreground="{StaticResource OverlayMutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />

            <TextBlock Margin="1,16,0,8"
                       Text="MODEL"
                       Style="{StaticResource SectionLabelStyle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="OnlineModelComboBox"
                          AutomationProperties.Name="Online model"
                          Height="40"
                          IsEditable="True"
                          Style="{StaticResource ModernComboBoxStyle}" />
                <Button x:Name="LoadModelsButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="Load models"
                        Click="LoadModelsButton_Click"
                        Style="{StaticResource OverlayButtonStyle}" />
            </Grid>

            <Border Margin="0,16,0,0"
                    Padding="12"
                    Background="{StaticResource OverlaySurfaceBrush}"
                    BorderBrush="{StaticResource OverlayBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock x:Name="PrivacyNoticeText"
                           Foreground="{StaticResource OverlayMutedTextBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        </StackPanel>

        <TextBlock x:Name="SettingsStatusText"
                   Margin="1,16,0,0"
                   Foreground="{StaticResource OverlayMutedTextBrush}"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <StackPanel Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button MinWidth="76"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click"
                    Style="{StaticResource OverlayButtonStyle}" />
            <Button x:Name="SaveButton"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_Click"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </StackPanel>
    </Border>
    </Border>
</Window>
